# macOS
.DS_Store
._*
__MACOSX/

# Xcode
PCL.Swift.xcodeproj/xcuserdata/
PCL.Swift.xcodeproj/project.xcworkspace/xcuserdata/

build.xcarchive

# 草稿与备份文件
# 工程用 FileSystemSynchronizedRootGroup 管理源码，目录里的任何文件都会自动入 Target；
# .bak 一类后缀不参与编译，但会被当成资源原样打包进 App 的 Resources，所以别留在源码树里。
*.bak
*.orig
*.swift.save

# 本地 profile / 性能分析产物（xctrace 录制、LLVM profile）
*.profraw
*.trace/
*.xcresult

# 本地密钥覆盖文件：本地开发把真实 Key 写这里，CI 走的是 Secrets.properties。
# 仓库里的 Resources/Secrets.properties 只有空模板，真实 Key 两边都不进版本库。
Resources/Secrets.local.properties

# 本地发版产物（archive / dmg 打包目录）
dist/
dmg_temp/
artifact/

# 本地工具状态（如 gh 的 device-id），不进版本库
.local/
