#include "Base.xcconfig"
DEBUG_MODE = YES

// 开发期专用能力的编译条件：⌘R 重播开场与设置向导、1–4 切顶栏页面。
//
// Release.xcconfig 刻意不定义它，所以这些代码在正式版里**根本不参与编译**，
// 而不是"编进去再在运行时藏起来"——没有可被误触发的入口，也没有多余符号。
// $(inherited) 保留 project 级的 DEBUG。
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) PCL_DEV_TOOLS

// Debug 也开优化。
//
// 默认的 -Onone 下，SwiftUI 每次 body 求值都要走未内联的泛型派发、
// 每个 ViewBuilder 分支都是一次真实函数调用。实测在 -Onone 下滚动
// 掉帧明显，而同一份代码在 Release 下顺滑——这不是代码写得慢，
// 是编译器没优化。
//
// -O + incremental 的组合仍保留断点与变量查看（个别内联掉的局部变量
// 可能显示 <optimized out>，但不影响正常调试）。
// 需要逐行单步时，临时把这里改回 -Onone 即可。
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = incremental
